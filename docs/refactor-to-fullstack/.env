# Application Configuration
APP_ENV=development
APP_NAME=Finance API
APP_VERSION=v0.0.1
APP_HOST=localhost
APP_LOGLEVEL=info

# REST Server Configuration
APP_REST_HOST=localhost
APP_REST_PORT=8080
APP_REST_USE_SSL=false
APP_RESTPREFORK=false
APP_REST_RECOVERY=true
APP_REST_ENABLE_STACK_TRACE=true

# Server Timeout Configuration
# Examples: 30s, 1m, 5m, 1h
APP_IDLE_TIMEOUT=120s
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s

# REST CORS Configuration (legacy - consider using CORS_* variables below)
APP_REST_CORS_ALLOW_ORIGINS=*
APP_REST_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
APP_REST_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Database Configuration
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=financeapi port=5432 sslmode=disable

# JWT Configuration
JWT_SECRET=/oXA3F1Fc3Rq1RTScIenY/l0Tu3NWuki1yvsgVR+xqE=
JWT_REFRESH_SECRET=q2FKl6/uQhCmY3JLITgX8sD2fmGYc6/cFR6Dnpbzmj4=
# JWT token expiration time (examples: 1h, 2h30m, 1d, 7d, 30m)
JWT_EXPIRES_IN=7d
# JWT refresh token expiration time (examples: 7d, 30d, 90d)
JWT_REFRESH_EXPIRES_IN=2d

# Redis Configuration
# Set to true to enable Redis for token management (recommended for production)
REDIS_ENABLED=false
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenAPI/Swagger Configuration
OPEN_API_TITLE=Finance API
OPEN_API_VERSION=v0.0.1
OPEN_API_SERVER_URL=http://localhost:8080
OPEN_API_SERVER_DESCRIPTION=This API powers your personal finance and transaction management system. Use it to track expenses, manage budgets, and analyze your financial data effortlessly.

# CORS Configuration
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400
