// This is your Prisma schema file
//
// IDs use CUID2 for sortable, collision-resistant identifiers
// Generated in application code using @paralleldrive/cuid2

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum AccountType {
  checking
  savings
  credit_card
  cash
  investment
  loan
}

enum CategoryType {
  income
  expense
  both
}

enum CategoryNature {
  WANT
  NEED
  MUST
}

enum TransactionType {
  income
  expense
  transfer_in
  transfer_out
  debt_in
  debt_out
}

enum DebtType {
  lend
  borrow
}

enum DebtStatus {
  active
  settled
  cancelled
}

enum SavedFilterContext {
  transaction
  analytics
  budget
}

enum AiChatRole {
  user
  assistant
  tool
}

// ==================== USER MODEL ====================
model User {
  id                 String    @id @default(cuid())
  email              String    @unique @db.VarChar(255)
  username           String    @unique @db.VarChar(100)
  password_hash      String    @db.VarChar(255)
  full_name          String?   @db.VarChar(255)
  email_verified     Boolean   @default(false)
  timezone           String    @default("UTC") @db.VarChar(50)
  date_format        String    @default("YYYY-MM-DD") @db.VarChar(20)
  number_format      String    @default("1,234.56") @db.VarChar(20)
  locale             String    @default("en-US") @db.VarChar(10)
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  deleted_at         DateTime? @db.Timestamptz
  has_ai_access      Boolean   @default(false)

  // Relations
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  debts         Debt[]
  transfers     Transfer[]
  labels        Label[]
  savedFilters  SavedFilter[]
  aiSessions    AiChatSession[]
}

// ==================== ACCOUNT MODEL ====================
model Account {
  id                   String      @id @default(cuid())
  user_id              String
  name                 String      @db.VarChar(100)
  account_type         AccountType @default(checking)
  initial_balance      Decimal     @default(0) @db.Decimal(15, 2)
  // current_balance removed - now calculated on-demand via BalanceService
  icon                 String      @db.VarChar(50)
  color                String      @db.VarChar(7)
  is_active            Boolean     @default(true)
  is_included_in_total Boolean     @default(true)
  order                Int         @default(0)
  created_at           DateTime    @default(now()) @db.Timestamptz
  updated_at           DateTime    @updatedAt @db.Timestamptz
  deleted_at           DateTime?   @db.Timestamptz
  created_by           String?     @db.VarChar(64)
  updated_by           String?     @db.VarChar(64)

  // Relations
  user           User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  debts          Debt[]

  @@index([user_id, deleted_at, order, created_at])
}

// ==================== CATEGORY MODEL ====================
model Category {
  id         String         @id @default(cuid())
  user_id    String
  parent_id  String?
  name       String         @db.VarChar(100)
  type          CategoryType
  analytic_flag String         @default("expense") @db.VarChar(20)
  nature        CategoryNature @default(WANT)
  icon       String         @db.VarChar(50)
  color      String?        @db.VarChar(7)
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now()) @db.Timestamptz
  updated_at DateTime       @updatedAt @db.Timestamptz
  created_by String?        @db.VarChar(64)
  updated_by String?        @db.VarChar(64)

  // Relations
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent       Category?              @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children     Category[]             @relation("CategoryHierarchy")
  transactions Transaction[]
  budget       CategoryBudget?

  @@index([user_id, type, created_at])
  @@index([parent_id])
}

// ==================== TRANSACTION MODEL ====================
model Transaction {
  id               String          @id @default(cuid())
  user_id          String
  account_id       String
  category_id      String?
  type             TransactionType
  amount           Decimal         @db.Decimal(15, 2)
  date             DateTime        @db.Timestamptz
  description      String?         @db.Text
  payee            String?         @db.VarChar(255)
  payment_method   String?         @db.VarChar(50)
  payment_status   String?         @db.VarChar(32)
  transfer_id      String?
  debt_id          String?
  is_draft         Boolean          @default(false)
  created_at       DateTime        @default(now()) @db.Timestamptz
  updated_at       DateTime        @updatedAt @db.Timestamptz
  deleted_at       DateTime?       @db.Timestamptz
  created_by       String?         @db.VarChar(64)
  updated_by       String?         @db.VarChar(64)

  // Relations
  user        User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account     Account               @relation(fields: [account_id], references: [id], onDelete: Cascade)
  category    Category?             @relation(fields: [category_id], references: [id], onDelete: SetNull)
  transfer    Transfer?             @relation(fields: [transfer_id], references: [id], onDelete: SetNull)
  debt        Debt?                 @relation(fields: [debt_id], references: [id], onDelete: SetNull)
  labels      TransactionLabel[]

  @@index([user_id, deleted_at, date(sort: Desc)])
  @@index([user_id, date])
  @@index([account_id, deleted_at])
  @@index([category_id])
  @@index([transfer_id])
  @@index([debt_id])
  // GIN trigram indexes for keyword search (managed via raw migration — Prisma cannot declare these natively):
  //   CREATE INDEX "Transaction_description_trgm_idx" ON "Transaction" USING gin (description gin_trgm_ops);
  //   CREATE INDEX "Transaction_payee_trgm_idx"       ON "Transaction" USING gin (payee gin_trgm_ops);
  // These allow ILIKE '%term%' to use an index instead of a sequential scan.
}

// ==================== TRANSFER MODEL ====================
model Transfer {
  id           String   @id @default(cuid())
  user_id      String
  date         DateTime @db.Timestamptz
  from_account String
  to_account   String
  amount       Decimal  @db.Decimal(15, 2)
  description  String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  created_by   String?  @db.VarChar(64)
  updated_by   String?  @db.VarChar(64)

  // Relations
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@index([from_account])
  @@index([to_account])
}

// ==================== LABEL MODEL ====================
model Label {
  id         String   @id @default(cuid())
  user_id    String
  name       String   @db.VarChar(50)
  color      String   @db.VarChar(7)
  created_at DateTime @default(now()) @db.Timestamptz
  created_by String?  @db.VarChar(64)
  updated_at DateTime @updatedAt @db.Timestamptz
  updated_by String?  @db.VarChar(64)

  // Relations
  user         User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions TransactionLabel[]

  @@index([user_id])
}

// ==================== TRANSACTION LABEL (JUNCTION) ====================
model TransactionLabel {
  id             String @id @default(cuid())
  transaction_id String
  label_id       String

  // Relations
  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  label       Label       @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@unique([transaction_id, label_id])
  @@index([transaction_id])
  @@index([label_id])
}

// ==================== CATEGORY BUDGET MODEL ====================
model CategoryBudget {
  id                    String   @id @default(cuid())
  category_id           String   @unique
  basic_monthly_amount  Decimal  @default(0) @db.Decimal(15, 2)
  extend_monthly_amount Decimal  @default(0) @db.Decimal(15, 2)
  basic_annual_amount   Decimal  @default(0) @db.Decimal(15, 2)
  extend_annual_amount  Decimal  @default(0) @db.Decimal(15, 2)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @updatedAt @db.Timestamptz

  // Relations
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

// ==================== DEBT MODEL ====================
model Debt {
  id             String     @id @default(cuid())
  user_id        String
  date           DateTime   @db.Timestamptz
  type           DebtType
  account_id     String
  counterparty   String     @db.VarChar(255) // Person/entity name
  // NOTE: No amount field - amount is stored in the linked Transaction record
  description    String?    @db.Text
  status         DebtStatus @default(active)
  created_at     DateTime   @default(now()) @db.Timestamptz
  updated_at     DateTime   @updatedAt @db.Timestamptz
  created_by     String?    @db.VarChar(64)
  updated_by     String?    @db.VarChar(64)

  // Relations
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@index([account_id])
  @@index([status])
}

// ==================== SAVED FILTER MODEL ====================
model SavedFilter {
  id         String             @id @default(cuid())
  user_id    String
  name       String             @db.VarChar(100)
  filters    Json
  context    SavedFilterContext @default(transaction)
  sort_order Int                @default(0)
  created_at DateTime           @default(now()) @db.Timestamptz
  updated_at DateTime           @updatedAt @db.Timestamptz

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name, context])
  @@index([user_id])
  @@index([user_id, context])
}

// ==================== AI CHAT SESSION MODEL ====================
model AiChatSession {
  id               String          @id @default(cuid())
  user_id          String
  title            String?         @db.VarChar(255)
  context_snapshot Json
  created_at       DateTime        @default(now()) @db.Timestamptz
  updated_at       DateTime        @updatedAt @db.Timestamptz

  // Relations
  user    User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([user_id])
  @@index([user_id, created_at(sort: Desc)])
}

// ==================== AI CHAT MESSAGE MODEL ====================
model AiChatMessage {
  id         String      @id @default(cuid())
  session_id String
  role       AiChatRole
  content    String      @db.Text
  created_at DateTime    @default(now()) @db.Timestamptz

  // Relations
  session AiChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([session_id, created_at])
}
