# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_app"

# JWT Secrets (generate strong secrets in production)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-in-production"

# App Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: External Services
SENDGRID_API_KEY=""
AWS_S3_BUCKET=""
SENTRY_DSN=""

# Google OAuth for Sheets Sync
GOOGLE_CLIENT_ID="something.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="something"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/sync/callback"

REDIS_URL=redis://localhost:6379
# -- AI Chat Assistant -------------------------------------------------------

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# SwiftRouter (OpenAI-compatible -- https://swiftrouter.com)
SWIFTROUTER_API_KEY=
SWIFTROUTER_BASE_URL=https://api.swiftrouter.com/v1
SWIFTROUTER_MODELS=gpt-5.4-mini,gpt-5.4,gpt-5.3-codex,gpt-5.2,gemma-3-4b,gemma-3-12b,gemini-2.5-pro,gemini-2.5-flash,claude-sonnet-4-6,claude-opus-4-6,qwen3-vl-235b-instruct,qwen3-vl-235b-a22b-instruct,qwen3-vl-235b,qwen2.-vl-72b-instruct,ministral-8b,ministral-3b,ministral-14b,kimi-k2.5,gpt-5.5
