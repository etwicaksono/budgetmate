  "eslintConfig": {
    "extends": [
      "next/core-web-vitals"
    ],
    "rules": {
      "react/prop-types": "off",
      "no-useless-catch": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
