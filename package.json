    "@floating-ui/react": "^0.27.16",
    "bootstrap": "^5.3.8",
    "next": "^16.0.0",
    "rc-slider": "^11.1.9",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-color": "^2.19.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^2.0.0",
    "recharts": "^3.3.0",
    "sweetalert2": "^11.26.3",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.1",
